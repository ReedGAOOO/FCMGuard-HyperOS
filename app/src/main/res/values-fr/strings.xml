    <string name="protection_title">Protection</string>
    <string name="automatic_protection">Protection automatique</string>
    <string name="automatic_protection_summary">Surveillance événementielle uniquement de la clé FCM. Une vérification de secours toutes les 30 minutes ne réveille pas volontairement un téléphone en veille.</string>
    <string name="persistent_notification">Notification persistante</string>
    <string name="persistent_notification_summary">Recommandé pour une fiabilité maximale. Désactivez-la pour supprimer la notification et utiliser le mode arrière-plan silencieux ; OriginOS pourra alors arrêter le service plus facilement.</string>
    <string name="actions_title">Outils</string>
    <string name="advanced_title">Configuration avancée</string>

    <string name="helper_text">Conception basse consommation : plus de scrutation toutes les 30 secondes, aucune surveillance de paramètres système sans rapport, et une demande de reconnexion FCM uniquement après une réparation réelle de la liste.</string>
    <string name="note_text">Sur OriginOS, gardez le démarrage automatique activé et le mode batterie sur Sans restrictions. Les options développeur, le débogage USB et le débogage sans fil ne sont pas nécessaires.</string>

