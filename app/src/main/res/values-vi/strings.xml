    <string name="automatic_protection">Bảo vệ tự động</string>
    <string name="automatic_protection_summary">Gửi nhịp tim FCM theo chu kỳ ngắn (kể cả khi máy ngủ sâu), khi đổi mạng và khi bật màn hình, để Google Play services kết nối lại ngay thay vì chờ đến nửa tiếng.</string>
    <string name="persistent_notification">Thông báo thường trực</string>
    <string name="persistent_notification_summary">Nên BẬT để ổn định nhất. TẮT sẽ ẩn thông báo và chỉ chạy nền; khi đó OriginOS dễ dừng dịch vụ hơn.</string>
    <string name="actions_title">Công cụ</string>
    <string name="advanced_title">Cấu hình nâng cao</string>

    <string name="helper_text">OriginOS không có công tắc công khai giống danh sách không giới hạn của HyperOS. AloFCM giữ kết nối đẩy của Google Play services bằng nhịp tim định kỳ. Hãy cho phép AloFCM chạy nền để nhịp tim được gửi liên tục.</string>
    <string name="note_text">Khuyến nghị trên OriginOS: bật Tự khởi động cho AloFCM và Google Play services, đặt Pin → Quản lý điện năng nền thành Cho phép, và khoá AloFCM trong Đa nhiệm. Không cần Tuỳ chọn nhà phát triển hay gỡ lỗi USB.</string>

