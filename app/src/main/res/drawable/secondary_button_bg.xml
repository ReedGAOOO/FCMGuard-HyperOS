<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary tonal action button with hairline border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/secondary_pressed" />
            <corners android:radius="@dimen/control_corner" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/surface_alt" />
            <corners android:radius="@dimen/control_corner" />
            <stroke android:width="1dp" android:color="@color/border" />
        </shape>
    </item>
</selector>
