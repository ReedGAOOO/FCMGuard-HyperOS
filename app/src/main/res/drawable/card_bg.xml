<?xml version="1.0" encoding="utf-8"?>
<!-- Surface card: white plate, hairline border, 24dp corners. Padding is set
     on the view so panels can override it locally. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface" />
    <corners android:radius="@dimen/card_corner" />
    <stroke android:width="1dp" android:color="@color/border" />
</shape>
