<?xml version="1.0" encoding="utf-8"?>
<!-- HyperOS-style pill switch track; the thumb (28dp) sets the overall 56x28dp size. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/switch_track_disabled" />
            <corners android:radius="14dp" />
            <size android:width="56dp" android:height="28dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape>
            <solid android:color="@color/primary_fill" />
            <corners android:radius="14dp" />
            <size android:width="56dp" android:height="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/switch_track_off" />
            <corners android:radius="14dp" />
            <size android:width="56dp" android:height="28dp" />
        </shape>
    </item>
</selector>
