<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/card_gap" android:orientation="vertical" android:background="@drawable/card_bg">
<TextView android:id="@+id/nightTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/night_title" android:textColor="@color/text_primary" android:textSize="16sp" android:paddingTop="8dp" />
<Switch android:id="@+id/nightSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/night_toggle" android:textColor="@color/text_primary" />
<TextView android:id="@+id/nightSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/night_disabled" android:textColor="@color/text_primary" android:textSize="15sp" android:paddingTop="8dp" />
<TextView android:id="@+id/nightWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/night_warning" android:textColor="@color/text_primary" android:textSize="13sp" android:paddingTop="8dp" />
<TextView android:id="@+id/nightExperimental" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/night_experimental" android:textColor="@color/text_primary" android:textSize="13sp" android:paddingTop="8dp" />
<Button android:id="@+id/nightCheck" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_check" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<Button android:id="@+id/nightRepair" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_repair" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<Button android:id="@+id/nightTest" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_test" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<Button android:id="@+id/nightCopy" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_copy" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<Button android:id="@+id/nightDebug" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_debug" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<LinearLayout android:id="@+id/nightDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"><TextView android:id="@+id/nightReport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/night_not_tested" android:textColor="@color/text_primary" android:textSize="13sp" android:paddingTop="8dp" />
<TextView android:id="@+id/nightLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/night_not_tested" android:textColor="@color/text_primary" android:textSize="12sp" android:paddingTop="8dp" />
<Button android:id="@+id/nightCopyLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_copy_logs" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<Button android:id="@+id/nightClearLogs" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_clear_logs" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
<Button android:id="@+id/nightCleanup" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/night_cleanup" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" />
</LinearLayout></LinearLayout>