<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="22dp"
        android:paddingRight="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:paddingTop="3dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="128dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/language"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_gravity="end" />

                <Spinner
                    android:id="@+id/languageSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:background="@drawable/pill_bg"
                    android:paddingLeft="10dp"
                    android:paddingRight="8dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg">

            <TextView
                android:id="@+id/statusHeadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_ready"
                android:textColor="@color/green"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:paddingTop="7dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_value_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="14dp" />

            <TextView
                android:id="@+id/currentValueText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textIsSelectable="true"
                android:paddingTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/protection_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/protectionSwitch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/automatic_protection"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:paddingTop="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/automatic_protection_summary"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp" />

            <Switch
                android:id="@+id/notificationSwitch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/persistent_notification"
                android:textColor="@color/text_primary"
                android:textSize="16sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/persistent_notification_summary"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/actions_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <Button
                android:id="@+id/repairBtn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/repair_now"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/primary_button_bg"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/wakeBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:text="@string/wake_fcm"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/secondary_button_bg"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/diagBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:text="@string/open_fcm_diag"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/secondary_button_bg"
                android:elevation="0dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/permissionBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="9dp"
                android:text="@string/grant_modify"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/secondary_button_bg"
                android:elevation="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/advanced_title"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_key"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="14dp" />

            <EditText
                android:id="@+id/keyEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/default_key"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:background="@null"
                android:paddingTop="7dp"
                android:paddingBottom="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_item"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingTop="12dp" />

            <EditText
                android:id="@+id/itemEdit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/default_required_item"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:background="@null"
                android:paddingTop="7dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/saveBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:text="@string/save_configuration"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:background="@drawable/secondary_button_bg"
                android:elevation="0dp"
                android:stateListAnimator="@null" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/helper_text"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:paddingTop="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/note_text"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:paddingTop="8dp" />

    </LinearLayout>
</ScrollView>
