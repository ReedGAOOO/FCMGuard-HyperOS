<?xml version="1.0" encoding="utf-8"?>
<!--
  Dashboard shell, redesigned in v1.8.0.

  Contract kept for the scroll-linked collapse machinery:
  - StickyDashboardLayout root, ids: root / stickyHeader / heroCard / statusCard /
    statusHeaderPanel / statusDetailsPanel / currentValuePanel / scroll
  - statusCard is a CollapsingStatusCard; statusDetailsPanel and currentValuePanel
    stay direct match_parent children in this order.
  - Hero corners 28dp = status_card_radius + status_card_inset (concentric dock).
-->
<com.reed.fcmguard.StickyDashboardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:background="@color/bg">
        <include layout="@layout/dashboard_scroll_content" />
    </ScrollView>

    <FrameLayout
        android:id="@+id/stickyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/sticky_top_padding"
        android:paddingRight="@dimen/page_horizontal_padding"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_height"
            android:orientation="vertical"
            android:background="@drawable/hero_bg"
            android:paddingLeft="@dimen/hero_inner_padding"
            android:paddingTop="@dimen/hero_inner_padding"
            android:paddingRight="@dimen/hero_inner_padding"
            android:paddingBottom="56dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/hero_title_size"
                        android:textStyle="bold"
                        android:letterSpacing="-0.01" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/hero_subtitle_size"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:paddingTop="4dp" />
                </LinearLayout>

                <Button
                    android:id="@+id/languageButton"
                    android:layout_width="@dimen/language_button_width"
                    android:layout_height="@dimen/language_button_height"
                    android:layout_marginLeft="@dimen/language_button_margin_start"
                    android:background="@drawable/hero_pill_bg"
                    android:text="Language"
                    android:textAllCaps="false"
                    android:textColor="@color/blue"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <com.reed.fcmguard.CollapsingStatusCard
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/status_card_inset"
            android:layout_marginTop="@dimen/status_expanded_top"
            android:layout_marginRight="@dimen/status_card_inset"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="16dp"
            android:paddingRight="18dp"
            android:paddingBottom="18dp"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/statusHeaderPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
                <TextView
                    android:id="@+id/statusHeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_ready"
                    android:textColor="@color/green"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:paddingTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusDetailsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/status_header_bg"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">
                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/currentValuePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tonal_bg"
                android:layout_marginTop="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_value_title"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:paddingLeft="12dp" />
                <TextView
                    android:id="@+id/currentValueText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:textIsSelectable="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="5dp" />
            </LinearLayout>
        </com.reed.fcmguard.CollapsingStatusCard>
    </FrameLayout>

</com.reed.fcmguard.StickyDashboardLayout>
