<?xml version="1.0" encoding="utf-8"?>
<com.reed.fcmguard.StickyDashboardLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- No background here: the root already paints @color/bg over the same area. -->
    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">
        <include layout="@layout/dashboard_scroll_content" />
    </ScrollView>

    <!--
      Band behind the fixed header (frosted glass, or the page colour when glass is off).
      Its bottom edge is a gradient, so content scrolling up fades out instead of being
      cut off. It spans the dashboard; StickyDashboardLayout sets how far down it draws
      (bottom of the docked status card + fade).
    -->
    <com.reed.fcmguard.GlassBackdropView
        android:id="@+id/headerBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/stickyHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="@dimen/page_horizontal_padding"
        android:paddingTop="@dimen/sticky_top_padding"
        android:paddingRight="@dimen/page_horizontal_padding"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hero_height"
            android:orientation="vertical"
            android:background="@drawable/hero_bg"
            android:paddingLeft="@dimen/hero_inner_padding"
            android:paddingTop="@dimen/hero_inner_padding"
            android:paddingRight="@dimen/hero_inner_padding"
            android:paddingBottom="56dp">

            <LinearLayout
                android:id="@+id/heroContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="@color/text_primary" android:textSize="@dimen/hero_title_size" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtitle" android:textColor="@color/text_secondary" android:textSize="@dimen/hero_subtitle_size" android:maxLines="2" android:ellipsize="end" android:paddingTop="3dp" />
                </LinearLayout>

                <!-- Globe + current language name; the text is set from code. -->
                <Button
                    android:id="@+id/languageButton"
                    android:layout_width="@dimen/language_button_width"
                    android:layout_height="@dimen/language_button_height"
                    android:layout_marginLeft="@dimen/language_button_margin_start"
                    android:background="@drawable/hero_pill_bg"
                    android:drawableLeft="@drawable/ic_language"
                    android:drawablePadding="5dp"
                    android:paddingLeft="11dp"
                    android:paddingRight="10dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textAllCaps="false"
                    android:textColor="@color/blue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <com.reed.fcmguard.CollapsingStatusCard
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/status_card_inset"
            android:layout_marginTop="@dimen/status_expanded_top"
            android:layout_marginRight="@dimen/status_card_inset"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="16dp"
            android:elevation="8dp">

            <LinearLayout
                android:id="@+id/statusHeaderPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="10dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_title" android:textColor="@color/text_secondary" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:id="@+id/statusHeadline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/status_ready" android:textColor="@color/green" android:textSize="25sp" android:textStyle="bold" android:paddingTop="2dp" android:drawablePadding="8dp" android:gravity="center_vertical" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/statusDetailsPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:background="@drawable/status_header_bg"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView android:id="@+id/statusMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:paddingBottom="2dp" android:visibility="gone" />
                <!--
                  Status tiles in two independent columns, filled most severe first row by row
                  (1 2 / 3 4 / 5 6). While the card collapses, each column stacks behind its
                  first tile; once stacked, each column is swiped and cycled on its own.
                -->
                <com.reed.fcmguard.StatusTileColumns
                    android:id="@+id/statusTileColumns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <com.reed.fcmguard.StatusTileStack android:id="@+id/statusTileStackLeft" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false">
                        <include android:id="@+id/statusTile1" layout="@layout/status_tile" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/statusTile3" layout="@layout/status_tile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
                        <include android:id="@+id/statusTile5" layout="@layout/status_tile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
                    </com.reed.fcmguard.StatusTileStack>
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <com.reed.fcmguard.StatusTileStack android:id="@+id/statusTileStackRight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clipChildren="false" android:clipToPadding="false">
                        <include android:id="@+id/statusTile2" layout="@layout/status_tile" android:layout_width="match_parent" android:layout_height="wrap_content" />
                        <include android:id="@+id/statusTile4" layout="@layout/status_tile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
                        <include android:id="@+id/statusTile6" layout="@layout/status_tile" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
                    </com.reed.fcmguard.StatusTileStack>
                </com.reed.fcmguard.StatusTileColumns>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/currentValuePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/tonal_bg"
                android:layout_marginTop="13dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/current_value_title" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
                <TextView android:id="@+id/currentValueText" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true" android:paddingTop="4dp" />
            </LinearLayout>
        </com.reed.fcmguard.CollapsingStatusCard>
    </FrameLayout>

</com.reed.fcmguard.StickyDashboardLayout>
