<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/page_horizontal_padding"
    android:paddingTop="0dp"
    android:paddingRight="@dimen/page_horizontal_padding"
    android:paddingBottom="@dimen/content_bottom_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/protection_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="3dp" />
        <Switch android:id="@+id/protectionSwitch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/automatic_protection" android:textColor="@color/text_primary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_protection_summary" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" />
        <Switch android:id="@+id/notificationSwitch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/persistent_notification" android:textColor="@color/text_primary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/persistent_notification_summary" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" />
        <Switch android:id="@+id/hideRecentsSwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:switchPadding="12dp" android:text="@string/hide_from_recents" android:textColor="@color/text_primary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/hide_from_recents_summary" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginTop="@dimen/card_gap">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/actions_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="9dp" />
        <Button android:id="@+id/repairBtn" android:layout_width="match_parent" android:layout_height="50dp" android:text="@string/repair_now" android:textAllCaps="false" android:textColor="@android:color/white" android:textStyle="bold" android:background="@drawable/primary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
            <Button android:id="@+id/wakeBtn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/wake_fcm" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/diagBtn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/open_fcm_diag" android:textAllCaps="false" android:textColor="@color/text_primary" android:textSize="13sp" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        </LinearLayout>
        <Button android:id="@+id/permissionBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/grant_modify" android:textAllCaps="false" android:textColor="@color/blue" android:textStyle="bold" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginTop="@dimen/card_gap">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fcm_apps_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fcm_apps_summary" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" android:paddingTop="5dp" />
        <Button android:id="@+id/scanFcmAppsBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/scan_fcm_apps" android:textAllCaps="false" android:textColor="@android:color/white" android:textStyle="bold" android:background="@drawable/primary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/openAutostartBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/open_autostart_manager" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <TextView android:id="@+id/fcmAppsStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fcm_apps_not_scanned" android:textColor="@color/text_secondary" android:textSize="12sp" android:paddingTop="11dp" />
        <LinearLayout android:id="@+id/fcmAppsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fcm_detection_note" android:textColor="@color/text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp" android:paddingTop="9dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginTop="@dimen/card_gap">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/advanced_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="10dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_key" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" />
        <EditText android:id="@+id/keyEdit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:singleLine="true" android:text="@string/default_key" android:textSize="14sp" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingLeft="12dp" android:paddingRight="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_item" android:textColor="@color/text_secondary" android:textSize="10sp" android:textStyle="bold" android:paddingTop="10dp" />
        <EditText android:id="@+id/itemEdit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:singleLine="true" android:text="@string/default_required_item" android:textSize="14sp" android:textColor="@color/text_primary" android:background="@drawable/input_bg" android:paddingLeft="12dp" android:paddingRight="12dp" />
        <Button android:id="@+id/saveBtn" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="@string/save_configuration" android:textAllCaps="false" android:textColor="@color/text_primary" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/info_card_bg"
        android:layout_marginTop="@dimen/card_gap">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/helper_text" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/note_text" android:textColor="@color/text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" android:paddingTop="7dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginTop="@dimen/card_gap">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/appearance_title" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <RadioGroup android:id="@+id/appearanceGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp">
            <RadioButton android:id="@+id/themeSystem" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/theme_system" android:textColor="@color/text_primary" android:textSize="12sp" />
            <RadioButton android:id="@+id/themeLight" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/theme_light" android:textColor="@color/text_primary" android:textSize="12sp" />
            <RadioButton android:id="@+id/themeDark" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/theme_dark" android:textColor="@color/text_primary" android:textSize="12sp" />
        </RadioGroup>
    </LinearLayout>

</LinearLayout>
