<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="@dimen/page_horizontal_padding"
    android:paddingTop="0dp"
    android:paddingRight="@dimen/page_horizontal_padding"
    android:paddingBottom="@dimen/content_bottom_padding">

    <!-- Section tabs: one section is shown at a time instead of one long page. -->
    <RadioGroup
        android:id="@+id/sectionTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/card_gap"
        android:background="@drawable/segmented_group_bg">
        <RadioButton android:id="@+id/tabProtection" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="@string/protection_title" android:textSize="13sp" android:textStyle="bold" />
        <RadioButton android:id="@+id/tabApps" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="@string/tab_apps" android:textSize="13sp" android:textStyle="bold" />
        <RadioButton android:id="@+id/tabTools" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="@string/actions_title" android:textSize="13sp" android:textStyle="bold" />
        <RadioButton android:id="@+id/tabAppearance" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:text="@string/appearance_title" android:textSize="13sp" android:textStyle="bold" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/sectionProtection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/protection_title" android:textColor="?attr/pal_text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="3dp" />
        <Switch android:id="@+id/protectionSwitch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/automatic_protection" android:textColor="?attr/pal_text_primary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/automatic_protection_summary" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
        <LinearLayout android:id="@+id/heartbeatIntervalRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/heartbeat_interval" android:textColor="?attr/pal_text_primary" android:textSize="15sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/heartbeat_interval_summary" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" android:paddingTop="2dp" />
            </LinearLayout>
            <Button android:id="@+id/heartbeatIntervalBtn" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginLeft="10dp" android:minWidth="76dp" android:minHeight="0dp" android:paddingLeft="14dp" android:paddingRight="14dp" android:textAllCaps="false" android:textColor="?attr/pal_button_tonal_text" android:textSize="13.5sp" android:textStyle="bold" android:singleLine="true" android:background="@drawable/tonal_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/pal_divider" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" />
        <Switch android:id="@+id/notificationSwitch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/persistent_notification" android:textColor="?attr/pal_text_primary" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/persistent_notification_summary" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/info_card_bg"
        android:layout_marginTop="@dimen/card_gap">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/note_text" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionApps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/fcm_apps_title" android:textColor="?attr/pal_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fcm_apps_summary" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" android:paddingTop="5dp" />
        <Button android:id="@+id/scanFcmAppsBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/scan_fcm_apps" android:textAllCaps="false" android:textColor="@android:color/white" android:textStyle="bold" android:background="@drawable/primary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/openAutostartBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/open_autostart_manager" android:textAllCaps="false" android:textColor="?attr/pal_text_primary" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/shizukuBtn" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_marginTop="8dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:textAllCaps="false" android:textColor="?attr/pal_text_primary" android:textSize="13sp" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <TextView android:id="@+id/fcmAppsStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fcm_apps_not_scanned" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:paddingTop="11dp" />
        <LinearLayout android:id="@+id/fcmAppsContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/fcm_detection_note" android:textColor="?attr/pal_text_secondary" android:textSize="11sp" android:lineSpacingExtra="2dp" android:paddingTop="9dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/actions_title" android:textColor="?attr/pal_text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="9dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/wakeBtn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/wake_fcm" android:textAllCaps="false" android:textColor="?attr/pal_text_primary" android:textSize="13sp" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
            <Space android:layout_width="8dp" android:layout_height="1dp" />
            <Button android:id="@+id/diagBtn" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/open_fcm_diag" android:textAllCaps="false" android:textColor="?attr/pal_text_primary" android:textSize="13sp" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        </LinearLayout>
        <Button android:id="@+id/autostartDiagBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/autostart_diag" android:textAllCaps="false" android:textColor="?attr/pal_text_primary" android:textSize="13sp" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
        <Button android:id="@+id/permissionBtn" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/grant_modify" android:textAllCaps="false" android:textColor="?attr/pal_blue" android:textStyle="bold" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginTop="@dimen/card_gap"
        android:visibility="gone">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/advanced_title" android:textColor="?attr/pal_text_primary" android:textSize="16sp" android:textStyle="bold" android:paddingBottom="10dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_key" android:textColor="?attr/pal_text_secondary" android:textSize="10sp" android:textStyle="bold" />
        <EditText android:id="@+id/keyEdit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:singleLine="true" android:text="@string/default_key" android:textSize="14sp" android:textColor="?attr/pal_text_primary" android:background="@drawable/input_bg" android:paddingLeft="12dp" android:paddingRight="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/label_item" android:textColor="?attr/pal_text_secondary" android:textSize="10sp" android:textStyle="bold" android:paddingTop="10dp" />
        <EditText android:id="@+id/itemEdit" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="5dp" android:singleLine="true" android:text="@string/default_required_item" android:textSize="14sp" android:textColor="?attr/pal_text_primary" android:background="@drawable/input_bg" android:paddingLeft="12dp" android:paddingRight="12dp" />
        <Button android:id="@+id/saveBtn" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="10dp" android:text="@string/save_configuration" android:textAllCaps="false" android:textColor="?attr/pal_text_primary" android:background="@drawable/secondary_button_bg" android:elevation="0dp" android:stateListAnimator="@null" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sectionAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/appearance_title" android:textColor="?attr/pal_text_primary" android:textSize="16sp" android:textStyle="bold" />
        <!-- Segmented control: three equal segments inside a tonal track. -->
        <RadioGroup android:id="@+id/appearanceGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp" android:background="@drawable/segmented_group_bg">
            <RadioButton android:id="@+id/themeSystem" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:text="@string/theme_system" android:textSize="13sp" />
            <RadioButton android:id="@+id/themeLight" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:text="@string/theme_light" android:textSize="13sp" />
            <RadioButton android:id="@+id/themeDark" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:button="@null" android:background="@drawable/segment_item_bg" android:gravity="center" android:singleLine="true" android:text="@string/theme_dark" android:textSize="13sp" />
        </RadioGroup>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/pal_divider" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" />
        <Switch android:id="@+id/glassSwitch" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/glass_material" android:textColor="?attr/pal_text_primary" android:textSize="15sp" />
        <TextView android:id="@+id/glassSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/glass_material_summary" android:textColor="?attr/pal_text_secondary" android:textSize="12sp" android:lineSpacingExtra="2dp" />
    </LinearLayout>

</LinearLayout>
